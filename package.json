{
  "name": "product-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "product-bench": "./product-bench.mjs"
  },
  "scripts": {
    "test": "node --test *.test.mjs",
    "check": "node generate.mjs --check && node check-package.mjs",
    "generate": "node generate.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "test:hosts": "node scripts/host-workflow-smoke.mjs",
    "test:ci": "npm run check && npm test && npm run test:install"
  },
  "description": "Local CLI and product-workflow bundle for Claude Code and Codex, with reviewed repository context, freshness checks, source proposals, and fictional analytics.",
